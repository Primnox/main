{
  "name": "primnox-ui",
  "private": true,
  "version": "1.2.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prebuild": "node scripts/strip-source.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:full": "cd ../backend && python fetch_pii_model.py && pyinstaller primnox_backend.spec --clean -y && cd ../frontend && npm run prebuild && tauri build --config src-tauri/tauri.bundle.conf.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test",
    "test:e2e": "node e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "vendor:fonts": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "dotenv": "^17.4.2",
    "framer-motion": "^10.16.2",
    "lucide-react": "^0.263.1",
    "motion": "^12.39.0",
    "playwright": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^3.0.1",
    "tailwind-merge": "^1.14.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.3.3",
    "terser": "^5.48.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "axios": "^1.18.0",
    "shell-quote": "^1.9.0",
    "brace-expansion": "^2.1.2",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.1",
    "tmp": "^0.2.6"
  }
}
