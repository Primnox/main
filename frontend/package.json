{
  "name": "primnox-ui",
  "private": true,
  "version": "0.0.6-alpha",
  "type": "module",
  "main": "public/electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prebuild": "node scripts/strip-source.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:full": "cd ../backend && pyinstaller primnox_backend.spec --clean -y && cd ../frontend && npm run prebuild && vite build && electron-builder"
  },
  "build": {
    "appId": "com.primnox.app",
    "productName": "Primnox",
    "publish": [
      {
        "provider": "github",
        "owner": "Cyanexani",
        "repo": "primnox_extension",
        "private": true
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      ".env",
      {
        "from": "../backend/dist/primnox_backend",
        "to": "primnox_backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "asar": true,
    "asarUnpack": [
      "primnox_backend/**/*"
    ]
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "framer-motion": "^10.16.2",
    "lucide-react": "^0.263.1",
    "motion": "^12.39.0",
    "playwright": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^3.0.1",
    "tailwind-merge": "^1.14.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^25.3.0",
    "electron-builder": "^24.6.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "terser": "^5.48.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "wait-on": "^7.0.1"
  }
}
