{
  "name": "primnox-ui",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "public/electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prebuild": "node scripts/strip-source.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:full": "cd ../backend && python fetch_pii_model.py && pyinstaller primnox_backend.spec --clean -y && cd ../frontend && npm run prebuild && vite build && electron-builder",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:full": "cd ../backend && python fetch_pii_model.py && pyinstaller primnox_backend.spec --clean -y && cd ../frontend && npm run prebuild && tauri build --config src-tauri/tauri.bundle.conf.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test",
    "test:e2e": "node e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "vendor:fonts": "node scripts/vendor-fonts.mjs"
  },
  "build": {
    "appId": "com.primnox.app",
    "productName": "Primnox",
    "publish": [
      {
        "provider": "github",
        "owner": "Primnox",
        "repo": "public",
        "private": false
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      ".env",
      {
        "from": "../backend/dist/primnox_backend",
        "to": "primnox_backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "asarUnpack": [
      "primnox_backend/**/*"
    ]
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "framer-motion": "^10.16.2",
    "lucide-react": "^0.263.1",
    "motion": "^12.39.0",
    "playwright": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^3.0.1",
    "tailwind-merge": "^1.14.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^25.3.0",
    "electron-builder": "^24.6.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "terser": "^5.48.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^2.1.9",
    "wait-on": "^7.0.1"
  }
}
