# Primnox V2 configuration.
#
# Copy this file to `.env` in the same folder and fill in your key. That file
# is gitignored, so the key never gets committed.
#
#     v2/.env.example  ->  v2/.env
#
# Anything set as a real environment variable wins over this file, so a key
# passed on the command line always takes precedence.
#
# Restart the backend after editing.

# ── Provider ────────────────────────────────────────────────────────────────
# Your current setup, from V1's settings. Paste the key after the "=" with no
# quotes and no spaces.
PRIMNOX_BASE_URL=https://capi.aerolink.lat
PRIMNOX_API_TYPE=anthropic
PRIMNOX_MODEL=claude-opus-4-8
PRIMNOX_API_KEY=

# Force the local echo provider instead — no network, no key. Useful for
# telling a runtime bug apart from a provider problem.
# PRIMNOX_PROVIDER=echo

# ── Sandbox ─────────────────────────────────────────────────────────────────
# Permission prompts: all (never ask) | safe (ask for shell only) | off (always ask)
# PRIMNOX2_AUTO_APPROVE=all

# Allow code execution with NO isolation. Only on a machine you are willing to
# run untrusted code on.
# PRIMNOX2_ALLOW_UNSANDBOXED=1

# ── Diagnostics ─────────────────────────────────────────────────────────────
# Record an execution trace for every turn (the Replay Recorder).
# PRIMNOX2_TRACE=1
