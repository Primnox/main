# Primnox Web server (Render). Copy to .env for local dev.

PORT=8787

# Supabase — service-role connection string (bypasses RLS; used only to assign
# the global sequence and append events). Never expose this to the client.
DATABASE_URL=postgres://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase Auth — JWKS endpoint for verifying the user's access token.
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISS=https://YOUR-PROJECT.supabase.co/auth/v1

# CRS/1.0-W §4.4 — how long a streaming turn may go without an event from its
# origin device before the watchdog fails it.
ORIGIN_GRACE_SECONDS=45

# Per-user request budget (coordination plane only; content is never seen).
RATE_LIMIT_PER_MIN=120

# GitHub App (sync job custody — Phase 1 wiring, not yet used).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# CORS: the deployed SPA origin.
CLIENT_ORIGIN=https://cyanexani.github.io
