
backend/.env
frontend/.env
backend/memory.db
backend/chat.db
backend/dist/
backend/models/
backend/__pycache__/
backend/*.pyc
# Catch nested bytecode caches anywhere in the tree
**/__pycache__/
**/*.pyc
# Editor / merge backups
*.orig
# Dev-only UI screenshots
ui-screenshots/
frontend/dist/
frontend/dist-electron/
*.map
*.spec
# V2's PyInstaller spec is hand-authored packaging source (hiddenimports,
# bundled data files), not a regenerated build artifact — keep it tracked.
!v2/backend/primnox2_backend.spec

node_modules/
frontend/node_modules/
backend/node_modules/

*.zip
backend/build/

artifacts_linux/
artifacts_mac/

# Secrets / encryption keys — never commit these
*.key
*.key.bak
*.vault

# Local runtime data / databases — may contain real user content
*.bak
*.db
*.db-wal
*.db-shm
chat.db
backend/*.json.bak
# Dev-leftover settings (real runtime settings live in %APPDATA%/primnox_extension/)
backend/settings.json

# Runtime media artifacts
*.wav
*.mp3

# Duplicated/large model weights — fetched at setup, not committed
yolov8n.pt
backend/yolov8n.pt

# Misc local-only logs/scratch
push_error.txt
*_output*.txt
*_output*.log
build_admin.log

# Runtime user data — feedback submissions carry a contact email, which was
# being committed to the repo.
backend/feedback.json
backend/chat_sessions.json
backend/memory.json
backend/memories.json

# Generated security-scan reports. These embed absolute build paths (and with
# them the builder's OS username) and are regenerated on every run.
bandit_report*.json

.venv/
backend/.venv/
# start.bat creates the venv as backend/venv (no dot), so ignore that spelling too.
venv/
backend/venv/

# Dropped-in Claude Skill packages (SKILL.md format). Deliberately NOT
# vendored: Anthropic's docx/pdf/pptx/xlsx skills are source-available but
# explicitly Proprietary, and this repo is public. Users install their own
# skills here locally; the README stays tracked so the folder is documented.
backend/skills/claude_skills/*
!backend/skills/claude_skills/README.md

# V2 local config — contains the API key. Never commit.
v2/.env

# Graphify's build output: an AST cache keyed by content hash, plus the graph
# it exports. Regenerated from source on every run and versioned by the
# extractor's own release (cache/ast/v0.9.42/...), so committing it means a
# 126MB diff that goes stale the next time graphify updates.
graphify-out/

# Rendered slide/document artifacts produced while checking output by eye.
/scratch-decks/
*.pptx.tmp

# Dropped-in skill packages, same reasoning as backend/skills/claude_skills
# above: these are third-party packs installed per-machine (design, animation,
# imagegen, taste), 7.7MB across ~380 files, each under its own author's
# licence, and this repo is public. Vendoring someone else's skill pack is a
# licensing question nobody asked, and they are reinstallable by name.
#
# `.claude/skills/testing` is the exception and stays tracked: it was written
# for THIS repo, it encodes the L0-L4 suite and the real harness commands, and
# it is worthless anywhere else.
.agents/skills/
.claude/skills/*
!.claude/skills/testing/
# Local hook wiring, machine-specific absolute paths.
.claude/settings.json
# Another copy of the same third-party skill pack, installed for a different
# harness. Same licensing reasoning as above.
.github/skills/
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json
.codex/

# Impeccable's working state: a served decision round, its answer log, and the
# hook's cache. Session scratch, not product truth. The direction it produced
# lives in the contract comment in v2/frontend/index.html, which IS tracked.
.impeccable/
