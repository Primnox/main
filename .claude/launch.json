{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "primnox-v2-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "backend/run.py"
      ],
      "port": 4109
    },
    {
      "name": "primnox-v2-backend-echo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "backend/run_echo.py"
      ],
      "port": 4109
    },
    {
      "name": "primnox-v2-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5273
    },
    {
      "name": "primnox-web-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web/client",
        "run",
        "dev"
      ],
      "port": 5274
    },
    {
      "name": "igloo-engine",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "labs/igloo-engine",
        "run",
        "dev"
      ],
      "port": 5178
    }
  ]
}
